# Example configuration for the PubMed client. Copy to `.env` and fill in your
# own values; `.env` is ignored by Git and must never be committed.
#
# The code reads real environment variables and does not load `.env` itself.
# To load it into your shell:  set -a; source .env; set +a
# See docs/PUBMED_INTEGRATION.md for details.

# Required: application name without whitespace, and a developer contact email.
PUBMED_NCBI_TOOL=healthcare_research_intelligence
PUBMED_NCBI_EMAIL=you@example.org

# Optional: NCBI API key. Leave blank to use the anonymous rate limit.
PUBMED_NCBI_API_KEY=

# Optional tuning; the commented values are the defaults.
# PUBMED_TIMEOUT_SECONDS=10
# PUBMED_REQUESTS_PER_SECOND=3
# PUBMED_MAX_RETRIES=2
# PUBMED_RETRY_BACKOFF_SECONDS=0.5
# PUBMED_EUTILITIES_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/
