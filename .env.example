# Example configuration for the PubMed client and the hri command. Copy to `.env` and fill in your
# own values; `.env` is ignored by Git and must never be committed.
#
# The code reads real environment variables and does not load `.env` itself.
# To load it into your shell:  set -a; source .env; set +a
# See docs/PUBMED_INTEGRATION.md for details.

# Required: application name without whitespace, and a developer contact email.
PUBMED_NCBI_TOOL=healthcare_research_intelligence
PUBMED_NCBI_EMAIL=you@example.org

# Optional: NCBI API key. Leave blank to use the anonymous rate limit.
PUBMED_NCBI_API_KEY=

# Optional: where the hri command keeps its SQLite database. The default is
# data/hri.sqlite3 in the current folder; the --db flag overrides both.
# HRI_DB_PATH=data/hri.sqlite3

# Optional: licences whose PMC full text may be stored, comma-separated.
# Blank means the strict default, CC0 and CC BY. Widening it is a content
# policy change that needs the project owner's approval (docs/CONTENT_POLICY.md).
# HRI_ALLOWED_LICENCES=CC0,CC BY

# AI answers (`hri ask`). Leave a key empty to skip that provider.
# Gemini's free tier uses prompts to improve Google's products: never put
# personal data in questions.
GEMINI_API_KEY=
GROQ_API_KEY=
# HRI_GEMINI_MODEL=gemini-3.5-flash-lite
# HRI_GROQ_MODEL=llama-3.3-70b-versatile
# HRI_LLM_DAILY_REQUEST_CAP=100

# Optional: where the embedding model is cached (default data/models).
# HRI_MODEL_CACHE=data/models

# Optional tuning; the commented values are the defaults.
# PUBMED_TIMEOUT_SECONDS=10
# PUBMED_REQUESTS_PER_SECOND=3
# PUBMED_MAX_RETRIES=2
# PUBMED_RETRY_BACKOFF_SECONDS=0.5
# PUBMED_EUTILITIES_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/
