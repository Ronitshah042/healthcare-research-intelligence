
# Environment variables and API keys
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*.pyo

# Test and development files
.pytest_cache/
.coverage
htmlcov/

# IDE and operating system files
.DS_Store
.vscode/
.idea/

# Logs
*.log

# Local data: keep the folders, never the downloaded or generated contents
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.sqlite3
*.db
