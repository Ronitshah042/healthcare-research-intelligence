# Copy to .streamlit/secrets.toml for local runs, or paste into the app's
# Secrets box on Streamlit Community Cloud. Never commit the real file.

# Where the data bundle is published (docs/DEPLOYMENT.md):
HRI_BUNDLE_URL = "https://github.com/<owner>/<repo>/releases/download/data-bundle/"

# AI answers (optional). Leave out to deploy search only.
GEMINI_API_KEY = ""
GROQ_API_KEY = ""
# Requests per day for the whole app (default 50 in the deployed app).
HRI_LLM_DAILY_REQUEST_CAP = "50"

# NCBI settings are only needed to build bundles or ingest, not to run the app.
# PUBMED_NCBI_TOOL = "your-registered-tool-name"
# PUBMED_NCBI_EMAIL = "developer@example.org"
# PUBMED_NCBI_API_KEY = ""
